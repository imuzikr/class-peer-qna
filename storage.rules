rules_version = '2';

// Final attachment cutover rules. The attachmentGateway authenticates each request,
// checks the source Firestore document with the caller's token, then uses Admin SDK
// to stream protected bytes. No browser can bypass that check through Storage.
// Rules do NOT revoke existing Firebase download tokens. Migrate references first,
// deploy these deny rules, THEN revoke old tokens and verify old URLs fail.
// See docs/protected-attachments-rollout.md for the gated operational sequence.
service firebase.storage {
  match /b/{bucket}/o {
    match /protected/{allPaths=**} {
      allow read, write: if false;
    }
    match /uploads/{allPaths=**} {
      allow read, write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
